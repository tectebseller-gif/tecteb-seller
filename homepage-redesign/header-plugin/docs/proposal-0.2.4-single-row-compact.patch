diff --git a/homepage-redesign/header-plugin/tecteb-header/assets/css/header.css b/homepage-redesign/header-plugin/tecteb-header/assets/css/header.css
index 97e22f9..4114a7e 100644
--- a/homepage-redesign/header-plugin/tecteb-header/assets/css/header.css
