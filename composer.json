{
    "name": "tecteb/tecteb-marketplace-core",
    "description": "Tecteb Marketplace Core - development-time dependencies only; the installable ZIP carries no vendor/ directory (see docs/adr/ADR-001-autoloader.md).",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpcompatibility/php-compatibility": "^10@dev",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload-dev": {
        "psr-4": {
            "Tecteb\\Marketplace\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.1.34"
        }
    },
    "scripts": {
        "test:unit": "phpunit --testsuite unit",
        "test:arch": "phpunit --testsuite architecture",
        "test:contract": "phpunit --testsuite contract --bootstrap tests/bootstrap-contract.php",
        "test:db": "phpunit --testsuite database --bootstrap tests/bootstrap-database.php",
        "compat": "phpcs --standard=PHPCompatibility --runtime-set testVersion 8.1- --extensions=php -p src tecteb-marketplace-core.php uninstall.php",
        "compat:mainfile": "phpcs --standard=PHPCompatibility --runtime-set testVersion 7.2- tecteb-marketplace-core.php",
        "test:packaging": "phpunit --testsuite packaging"
    }
}
